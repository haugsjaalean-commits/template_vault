filters:
  and:
    - '!file.inFolder("Obsidian/Templates")'
    - '!file.inFolder("Obsidian/Characteristics")'
formulas:
  word count: file.WordCount()
  link distance: file.linkDistance()
  value: (payoff/difficulty).round(2)
  is a contains self: file.isA() == self
  is_is_a: this.file == note["is a"]
  is_type_of: this.file == note["TYPE OF"]
  connection type: if(formula["is_is_a"], "is a", if(formula["is_type_of"], "type of", "misc"))
  Untitled: ""
  file: file
  is is a: this.file == note["is a"]
  is type of: this.file == note["TYPE OF"]
properties:
  formula.word count:
    displayName: word count
  formula.link distance:
    displayName: link distance
views:
  - type: graph
    name: Graph
    groupBy:
      property: is a
      direction: ASC
    order:
      - file.name
    sort:
      - property: formula.word count
        direction: ASC
    graphOptions:
      collapse-filter: false
      search: ""
      showTags: true
      showAttachments: true
      hideUnresolved: false
      showOrphans: true
      collapse-color-groups: false
      colorGroups:
        - query: "path:Obsidian/Templates  "
          color:
            a: 1
            rgb: 14725458
        - query: "path:Obsidian/Bases  "
          color:
            a: 1
            rgb: 11657298
        - query: "path:Obsidian/Characteristics  "
          color:
            a: 1
            rgb: 5419488
      collapse-display: false
      showArrow: true
      textFadeMultiplier: 0
      nodeSizeMultiplier: 1
      lineSizeMultiplier: 1
      collapse-forces: true
      centerStrength: 0.566048780487805
      repelStrength: 20
      linkStrength: 1
      linkDistance: 30
      scale: 0.08317427835927543
      close: true
    ringRank: proportional
    ringSpread: 11
  - type: table
    name: Table
    groupBy:
      property: is a
      direction: ASC
    order:
      - file.name
      - file.tags
    sort:
      - property: file.tags
        direction: ASC
