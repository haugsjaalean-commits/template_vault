filters:
  and:
    - '!file.inFolder("Obsidian/Templates")'
    - '!file.inFolder("Obsidian/Characteristics")'
formulas:
  word count: file.WordCount()
properties:
  formula.word count:
    displayName: word count
views:
  - type: graph
    name: Graph
    groupBy:
      property: is a
      direction: ASC
    order:
      - file.name
    sort:
      - property: formula.word count
        direction: ASC
    graphOptions:
      collapse-filter: false
      search: ""
      showTags: true
      showAttachments: true
      hideUnresolved: false
      showOrphans: true
      collapse-color-groups: false
      colorGroups:
        - query: "path:Obsidian/Templates  "
          color:
            a: 1
            rgb: 14725458
        - query: "path:Obsidian/Bases  "
          color:
            a: 1
            rgb: 11657298
        - query: "path:Obsidian/Characteristics  "
          color:
            a: 1
            rgb: 5419488
      collapse-display: false
      showArrow: true
      textFadeMultiplier: 0
      nodeSizeMultiplier: 1
      lineSizeMultiplier: 1
      collapse-forces: true
      centerStrength: 0.566048780487805
      repelStrength: 20
      linkStrength: 1
      linkDistance: 30
      scale: 0.11660891579457136
      close: true
    ringRank: proportional
    ringSpread: 11
  - type: table
    name: Table
    groupBy:
      property: is a
      direction: ASC
    order:
      - file.name
      - file.tags
    sort:
      - property: file.tags
        direction: ASC
