filters:
  and:
    - file.isA("Todo")
    - '!file.inFolder("Obsidian/Templates")'
formulas:
  word count: file.WordCount()
properties:
  formula.word count:
    displayName: word count
views:
  - type: table
    name: Table
    groupBy:
      property: done
      direction: ASC
    order:
      - done
      - file.name
      - urgency
      - payoff
