filters:
  and:
    - file.isA("Sub Goal")
    - '!file.inFolder("Obsidian/Templates")'
formulas:
  word count: file.WordCount()
  link distance: file.linkDistance()
  value: (payoff/difficulty).round(2)
  is a contains self: file.isA() == self
  is_is_a: this.file == note["is a"]
  is_type_of: this.file == note["TYPE OF"]
  connection type: if(formula["is_is_a"], "is a", if(formula["is_type_of"], "type of", "misc"))
  Untitled: ""
  file: file
  is is a: this.file == note["is a"]
  is type of: this.file == note["TYPE OF"]
properties:
  formula.word count:
    displayName: word count
  formula.link distance:
    displayName: link distance
views:
  - type: table
    name: Table
    order:
      - file.name
      - working towards
      - activity
      - active priority
      - difficulty
      - payoff
      - dead
      - subject
      - category
      - related
      - note rating
      - rating
      - created
      - garden
      - life stage
      - ext links
      - evolution
      - goal type
      - goal subject
  - type: table
    name: dynamic sub goals
    filters:
      and:
        - note["working towards"].contains(this.file)
        - done != true
    groupBy:
      property: checkpoint
      direction: ASC
    order:
      - done
      - active priority
      - file.name
      - activity
      - formula.value
      - payoff
      - difficulty
      - urgency
    sort:
      - property: activity
        direction: ASC
      - property: active priority
        direction: DESC
    declaredOrder:
      - activity
    declaredGroupOrder: checkpoint
