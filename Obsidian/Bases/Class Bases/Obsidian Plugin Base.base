filters:
  and:
    - file.hasA("Obsidian Plugin")
    - '!file.inFolder("Obsidian/Templates")'
formulas:
  word count: file.WordCount()
  link distance: file.linkDistance()
  value: (payoff/difficulty).round(2)
  is a contains self: file.isA() == self
  is_is_a: this.file == note["is a"]
  is_type_of: this.file == note["TYPE OF"]
  connection type: if(formula["is_is_a"], "is a", if(formula["is_type_of"], "type of", "misc"))
  Untitled: ""
  file: file
  is is a: this.file == note["is a"]
  is type of: this.file == note["TYPE OF"]
properties:
  formula.word count:
    displayName: word count
  formula.link distance:
    displayName: link distance
views:
  - type: table
    name: Select view
    filters:
      and:
        - dead != true
        - '!file.isA("Sub Goal")'
    groupBy:
      property: done
      direction: ASC
    order:
      - active priority
      - file.name
      - formula.value
      - payoff
      - difficulty
      - checkpoint
      - activity
    sort:
      - property: checkpoint
        direction: ASC
      - property: activity
        direction: ASC
      - property: active priority
        direction: DESC
    declaredOrder:
      - checkpoint
      - activity
