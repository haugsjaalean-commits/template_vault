filters:
  and:
    - file.isA("Improvement")
    - '!file.inFolder("Obsidian/Templates")'
formulas:
  word count: file.WordCount()
  link distance: file.linkDistance()
  value: (payoff/difficulty).round(2)
properties:
  formula.word count:
    displayName: word count
  formula.link distance:
    displayName: link distance
views:
  - type: table
    name: project Class Manager
    filters:
      and:
        - project.contains(link("Class Manager"))
        - done != true
        - abandoned != true
    groupBy:
      property: checkpoint
      direction: ASC
    order:
      - done
      - active priority
      - file.name
      - activity
      - is a
      - formula.value
      - payoff
      - difficulty
      - abandoned
    sort:
      - property: activity
        direction: ASC
      - property: active priority
        direction: DESC
      - property: is a
        direction: ASC
      - property: formula.value
        direction: ASC
    columnSize:
      file.name: 324
      note.activity: 95
      note.is a: 163
      note.payoff: 74
      note.difficulty: 84
    declaredOrder:
      - activity
    declaredGroupOrder: checkpoint
  - type: table
    name: All by project
    groupBy:
      property: project
      direction: ASC
    order:
      - active priority
      - file.name
      - journey
      - checkpoint
      - activity
    sort:
      - property: journey
        direction: ASC
      - property: checkpoint
        direction: ASC
      - property: activity
        direction: ASC
      - property: active priority
        direction: DESC
    columnSize:
      file.name: 349
      note.activity: 95
      note.urgency: 139
    declaredOrder:
      - journey
      - checkpoint
      - activity
  - type: table
    name: All by journey
    groupBy:
      property: done
      direction: ASC
    order:
      - done
      - active priority
      - file.name
      - journey
      - checkpoint
      - activity
      - abandoned
      - note.note
      - is a
    sort:
      - property: checkpoint
        direction: ASC
      - property: activity
        direction: ASC
      - property: active priority
        direction: DESC
    columnSize:
      file.name: 349
      note.activity: 95
      note.note: 175
      note.is a: 133
    declaredOrder:
      - checkpoint
      - activity
