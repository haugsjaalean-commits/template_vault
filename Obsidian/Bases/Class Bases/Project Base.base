filters:
  and:
    - file.isA("Project")
    - '!file.inFolder("Obsidian/Templates")'
formulas:
  word count: file.WordCount()
  link distance: file.linkDistance()
  value: (payoff/difficulty).round(2)
properties:
  formula.word count:
    displayName: word count
  formula.link distance:
    displayName: link distance
views:
  - type: table
    name: Table
    groupBy:
      property: is a
      direction: ASC
    order:
      - file.name
      - status
      - activity
    sort:
      - property: status
        direction: ASC
    columnSize:
      file.name: 321
      note.status: 122
