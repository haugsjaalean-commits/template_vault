filters:
  and:
    - file.inFolder("Obsidian/Characteristics")
formulas:
  word count: file.WordCount()
properties:
  formula.word count:
    displayName: word count
views:
  - type: table
    name: Table
    groupBy:
      property: is base characteristic
      direction: ASC
    order:
      - file.name
      - characteristic meaning
      - property type
      - possible values
      - file.backlinks
    sort:
      - property: file.backlinks
        direction: ASC
      - property: property type
        direction: ASC
    columnSize:
      file.name: 124
      note.possible values: 329
