filters:
  and:
    - file.isA("Visual Artist")
    - '!file.inFolder("Obsidian/Templates")'
formulas:
  word count: file.WordCount()
properties:
  formula.word count:
    displayName: word count
views:
  - type: table
    name: Table
    order:
      - file.name
      - medium
      - visual domain
      - domain
      - children
      - location
      - relation to me
      - related
      - note rating
      - rating
