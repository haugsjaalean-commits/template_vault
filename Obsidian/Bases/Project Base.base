filters:
  and:
    - file.isA("Project")
    - '!file.inFolder("Obsidian/Templates")'
formulas:
  word count: file.WordCount()
properties:
  formula.word count:
    displayName: word count
views:
  - type: table
    name: Table
    groupBy:
      property: activity
      direction: ASC
    order:
      - file.name
      - status
      - activity
    sort:
      - property: status
        direction: ASC
    columnSize:
      file.name: 321
      note.status: 122
