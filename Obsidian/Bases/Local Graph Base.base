filters:
  and:
    - file.linkDistance() <= 4
    - '!file.inFolder("Obsidian/Templates")'
formulas:
  word count: file.WordCount()
  link distance: file.linkDistance()
  value: (payoff/difficulty).round(2)
properties:
  formula.word count:
    displayName: word count
  formula.link distance:
    displayName: link distance
views:
  - type: graph
    name: Graph
    groupBy:
      property: is a
      direction: ASC
    sort:
      - property: formula.word count
        direction: DESC
    graphOptions:
      collapse-filter: true
      search: ""
      showTags: false
      showAttachments: false
      hideUnresolved: false
      showOrphans: true
      collapse-color-groups: true
      colorGroups: []
      collapse-display: true
      showArrow: true
      textFadeMultiplier: 0
      nodeSizeMultiplier: 1
      lineSizeMultiplier: 1
      collapse-forces: true
      centerStrength: 0.566048780487805
      repelStrength: 20
      linkStrength: 1
      linkDistance: 30
      scale: 0.15482644388962452
      close: true
    neighbourDepth: 0
    ringSpread: 19
    ringUncapped: false
    ringSpeed: 23
    ringRank: proportional
  - type: table
    name: Table
    groupBy:
      property: formula.link distance
      direction: ASC
    order:
      - file.name
      - formula.word count
    sort:
      - property: formula.word count
        direction: DESC
    columnSize:
      file.name: 286
