filters:
  and:
    - or:
        - file.inFolder("Obsidian/Characteristics")
        - file.hasTag("class")
formulas:
  word count: file.WordCount()
  link distance: file.linkDistance()
  value: (payoff/difficulty).round(2)
  is a contains self: file.isA() == self
  is_is_a: this.file == note["is a"]
  is_type_of: this.file == note["TYPE OF"]
  connection type: if(formula["is_is_a"], "is a", if(formula["is_type_of"], "type of", "misc"))
  Untitled: ""
  file: file
  is is a: this.file == note["is a"]
  is type of: this.file == note["TYPE OF"]
properties:
  formula.word count:
    displayName: word count
  formula.link distance:
    displayName: link distance
views:
  - type: table
    name: Table
    groupBy:
      property: file.folder
      direction: DESC
    order:
      - rating
      - file.name
      - type of
      - characteristics
    sort:
      - property: type of
        direction: ASC
      - property: rating
        direction: DESC
  - type: graph
    name: Graph
    groupBy:
      property: file.tags
      direction: DESC
    order:
      - file.name
    sort:
      - property: is base characteristic
        direction: DESC
    graphOptions:
      collapse-filter: true
      search: ""
      showTags: false
      showAttachments: false
      hideUnresolved: false
      showOrphans: true
      collapse-color-groups: true
      colorGroups: []
      collapse-display: false
      showArrow: true
      textFadeMultiplier: -0.7
      nodeSizeMultiplier: 1
      lineSizeMultiplier: 1
      collapse-forces: false
      centerStrength: 0.566048780487805
      repelStrength: 20
      linkStrength: 1
      linkDistance: 30
      scale: 0.16355533498910796
      close: true
    ringRank: value
    ringSpread: 1.5
  - type: table
    name: Base Classes
    filters:
      and:
        - note["type of"].isEmpty()
        - file.inFolder("Obsidian/Notes")
    groupBy:
      property: file.tags
      direction: ASC
    order:
      - rating
      - file.name
      - characteristics
    sort:
      - property: rating
        direction: DESC
