filters:
  and:
    - file.isA("Class Note")
    - '!file.inFolder("Obsidian/Templates")'
formulas:
  word count: file.WordCount()
properties:
  formula.word count:
    displayName: word count
views:
  - type: table
    name: Table
    order:
      - file.name
      - cours
      - class date
      - class number
      - related
      - note rating
      - rating
      - created
      - garden
      - life stage
      - ext links
      - maturity
