filters:
  and:
    - file.isA("Teacher")
    - '!file.inFolder("Obsidian/Templates")'
formulas:
  word count: file.WordCount()
properties:
  formula.word count:
    displayName: word count
views:
  - type: table
    name: Table
    order:
      - file.name
      - children
      - relation to me
      - location
      - birth day
      - death day
      - historical importance
      - related
      - note rating
      - rating
      - created
      - garden
      - life stage
      - ext links
      - maturity
