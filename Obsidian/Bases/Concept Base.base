filters:
  and:
    - file.isA("Concept")
    - '!file.inFolder("Obsidian/Templates")'
formulas:
  word count: file.WordCount()
properties:
  formula.word count:
    displayName: word count
views:
  - type: table
    name: Table
    order:
      - file.name
      - meaning
      - language
      - gender
      - entomology
      - false friend
      - friend
      - related
      - note rating
      - rating
      - created
      - garden
      - life stage
      - ext links
      - maturity
