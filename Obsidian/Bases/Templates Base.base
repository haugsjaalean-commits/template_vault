filters:
  and:
    - file.inFolder("Obsidian/Templates")
formulas:
  word count: file.WordCount()
properties:
  formula.word count:
    displayName: word count
views:
  - type: table
    name: All
  - type: table
    name: Architypes
    filters:
      and:
        - file.name.contains("architype")
    order:
      - file.name
      - is a
