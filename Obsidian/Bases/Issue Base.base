filters:
  and:
    - file.isA("Issue")
    - '!file.inFolder("Obsidian/Templates")'
formulas:
  word count: file.WordCount()
properties:
  formula.word count:
    displayName: word count
views:
  - type: table
    name: Table
    groupBy:
      property: project
      direction: ASC
    order:
      - file.name
      - status
      - activity
      - urgency
    sort:
      - property: status
        direction: ASC
      - property: activity
        direction: ASC
      - property: created
        direction: ASC
    columnSize:
      file.name: 349
      note.activity: 95
      note.urgency: 139
