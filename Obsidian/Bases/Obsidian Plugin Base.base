filters:
  and:
    - file.isA("Obsidian Plugin")
    - '!file.inFolder("Obsidian/Templates")'
formulas:
  word count: file.WordCount()
properties:
  formula.word count:
    displayName: word count
views:
  - type: table
    name: Table
    order:
      - file.name
      - activity
      - status
      - lifespan
      - importance
    sort:
      - property: activity
        direction: ASC
      - property: status
        direction: ASC
    columnSize:
      note.activity: 117
      note.status: 106
