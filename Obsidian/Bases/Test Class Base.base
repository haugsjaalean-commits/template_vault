filters:
  and:
    - file.isA("Test Class")
    - '!file.inFolder("Obsidian/Templates")'
formulas:
  word count: file.WordCount()
properties:
  formula.word count:
    displayName: word count
views:
  - type: table
    name: Table
    order:
      - file.name
      - project
      - subject
      - medium
      - visual domain
      - related
      - note rating
      - rating
      - created
      - garden
      - life stage
      - ext links
      - maturity
      - activity
      - importance
      - status
      - creation domain
      - masetery
      - children
      - relation to me
      - location
      - birth day
      - death day
      - historical importance
